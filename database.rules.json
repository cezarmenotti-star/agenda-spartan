{
  "rules": {
    ".read": false,
    ".write": false,
    "roles": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && root.child('roles').child(auth.uid).child('role').val() === 'admin'"
      }
    },
    "schedule": {
      "consultores": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('roles').child(auth.uid).child('role').val() === 'admin'"
      },
      "blockedTimes": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('roles').child(auth.uid).child('role').val() === 'admin'"
      },
      "occupiedSlots": {
        ".read": "auth != null",
        ".write": "auth != null"
      },
      "appointments": {
        ".read": "auth != null && root.child('roles').child(auth.uid).child('role').val() === 'admin'",
        "$ownerUid": {
          ".read": "auth != null && auth.uid === $ownerUid",
          ".write": "auth != null && (auth.uid === $ownerUid || root.child('roles').child(auth.uid).child('role').val() === 'admin')"
        }
      }
    }
  }
}
